{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/clipcraft-labs/capcut-draft/main/schemas/project.v1.schema.json",
  "title": "Clipcraft Project v1",
  "type": "object",
  "required": ["version", "canvas", "tracks"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "version": { "const": 1 },
    "name": { "type": "string" },
    "target": {
      "type": "object",
      "properties": {
        "app": { "enum": ["capcut"] },
        "version": { "type": "string" },
        "os": { "enum": ["mac", "windows"] }
      },
      "additionalProperties": false
    },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "fps"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "integer", "minimum": 1 },
        "ratio": { "type": "string" }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "description": "CapCut catalogue IDs resolved automatically by clipcraft project render.",
      "additionalProperties": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9]+$" },
          "provider": { "const": "capcut" },
          "kind": { "enum": ["auto", "effect", "filter", "transition", "caption-template", "body-effect", "sticker", "animation", "text-animation", "audio-effect", "font", "text-effect", "mask", "image", "stock-video", "material"] }
        },
        "additionalProperties": false
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "items"],
        "properties": {
          "type": { "enum": ["video", "image", "audio", "text"] },
          "name": { "type": "string" },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["at", "duration"],
              "properties": {
                "src": { "type": "string" },
                "resource": { "type": "string" },
                "text": { "type": "string" },
                "at": { "type": "number", "minimum": 0 },
                "duration": { "type": "number", "exclusiveMinimum": 0 },
                "ref": { "type": "string" },
                "fontSize": { "type": "number" },
                "color": { "type": "string" },
                "fit": { "enum": ["contain", "cover"] },
                "scale": { "type": "number", "exclusiveMinimum": 0 },
                "alpha": { "type": "number", "minimum": 0, "maximum": 1 },
                "volume": { "type": "number", "minimum": 0 },
                "renderIndex": { "type": "integer" },
                "position": {
                  "type": "object",
                  "properties": {
                    "x": { "type": "number" },
                    "y": { "type": "number" }
                  },
                  "additionalProperties": false
                },
                "fontFamily": { "type": "string" },
                "alignment": { "type": "integer" },
                "backgroundColor": { "type": "string" },
                "backgroundAlpha": { "type": "number", "minimum": 0, "maximum": 1 },
                "borderColor": { "type": "string" },
                "borderWidth": { "type": "number", "minimum": 0 },
                "boldWidth": { "type": "number", "minimum": 0 },
                "shadowAlpha": { "type": "number", "minimum": 0, "maximum": 1 },
                "letterSpacing": { "type": "number" },
                "lineSpacing": { "type": "number" }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target", "resource"],
        "properties": {
          "type": { "enum": ["effect", "filter", "transition", "caption-template", "body-effect", "sticker", "animation", "text-animation", "audio-effect", "font", "text-effect", "mask"] },
          "target": { "type": "string" },
          "resource": { "type": "string" },
          "duration": { "type": "number", "exclusiveMinimum": 0 },
          "intensity": { "type": "number", "minimum": 0, "maximum": 1 },
          "scale": { "type": "number", "exclusiveMinimum": 0 },
          "alpha": { "type": "number", "minimum": 0, "maximum": 1 },
          "renderIndex": { "type": "integer" },
          "animationType": { "enum": ["in", "out", "group", "loop"] },
          "start": { "type": "number", "minimum": 0 },
          "centerX": { "type": "number" },
          "centerY": { "type": "number" },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "height": { "type": "number", "exclusiveMinimum": 0 },
          "aspectRatio": { "type": "number", "exclusiveMinimum": 0 },
          "rotation": { "type": "number" },
          "invert": { "type": "boolean" },
          "feather": { "type": "number", "minimum": 0, "maximum": 1 },
          "roundCorner": { "type": "number", "minimum": 0, "maximum": 1 },
          "resourceType": { "type": "string" },
          "position": {
            "type": "object",
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
